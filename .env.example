# Gateway (HTTPS entry points — these are the ports exposed to the host)
APP_PORT=8080
FRONTEND_PORT=3000
PMA_PORT=8081

# Frontend — URL of the API as seen from the browser (matches APP_PORT)
API_BASE=https://localhost:8080

# App
JWT_SECRET=change-me-in-production
CORS_ORIGIN=https://localhost:3000

# Database
DB_HOST=db
DB_PORT=3306
MYSQL_DATABASE=livestream_app
MYSQL_ROOT_PASSWORD=rootpassword
MYSQL_USER=appuser
MYSQL_PASSWORD=apppassword

# NGINX media server (internal Docker network — do not expose externally)
MEDIA_SERVER_URL=http://nginx/segments
